<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
	<op:config name="%PVF_NumChannelsDefault%" value="1" />
	<ManufacturerData>
		<Manufacturer>
			<ApplicationPrograms>
				<ApplicationProgram>
					<Static>
						<ParameterTypes>
							<ParameterType Id="%AID%_PT-PVFNumChannels" Name="PVFNumChannels">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="%N%" />
							</ParameterType>
							<ParameterType Id="%AID%_PT-PVFProviderType" Name="PVFProviderType">
								<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
									<Enumeration Text="Deaktiviert"    Value="0" Id="%ENID%" />
									<Enumeration Text="forecast.solar" Value="1" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-PVFRefreshInterval" Name="PVFRefreshInterval">
								<TypeRestriction Base="Value" SizeInBit="8">
									<Enumeration Text="Keine"       Value="0" Id="%ENID%" />
									<Enumeration Text="30 Minuten"  Value="1" Id="%ENID%" />
									<Enumeration Text="Jede Stunde" Value="2" Id="%ENID%" />
									<Enumeration Text="Täglich"     Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<!-- Latitude/Longitude stored as degrees * 100 (int16) -->
							<ParameterType Id="%AID%_PT-PVFLatitude" Name="PVFLatitude">
								<TypeNumber SizeInBit="16" Type="signedInt" minInclusive="-9000" maxInclusive="9000" />
							</ParameterType>
							<ParameterType Id="%AID%_PT-PVFLongitude" Name="PVFLongitude">
								<TypeNumber SizeInBit="16" Type="signedInt" minInclusive="-18000" maxInclusive="18000" />
							</ParameterType>
							<!-- Plane tilt 0..90 degrees -->
							<ParameterType Id="%AID%_PT-PVFTilt" Name="PVFTilt">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="90" />
							</ParameterType>
							<!-- Azimuth -180..180 degrees (0=South, -90=East, 90=West) -->
							<ParameterType Id="%AID%_PT-PVFAzimuth" Name="PVFAzimuth">
								<TypeNumber SizeInBit="16" Type="signedInt" minInclusive="-180" maxInclusive="180" />
							</ParameterType>
							<!-- Peak power in kWp * 100 (uint16), range 0..5000 → 0..50.00 kWp -->
							<ParameterType Id="%AID%_PT-PVFPeakPower" Name="PVFPeakPower">
								<TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="5000" />
							</ParameterType>
						</ParameterTypes>
						<Parameters>
							<!-- Number of channels -->
							<Union SizeInBit="8">
								<Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
								<Parameter Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-PVFNumChannels" Offset="0" BitOffset="0" Text="Verfügbare Kanäle" Value="%PVF_NumChannelsDefault%" SuffixText=" von %N%" />
							</Union>
						</Parameters>
						<ParameterRefs>
							<ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
						</ParameterRefs>
						<ComObjectTable>
							<!-- Refresh PV Forecast Data -->
							<ComObject Id="%AID%_O-%TT%00001" Name="RefreshData" Text="PV-Prognose aktualisieren" Number="0" FunctionText="PVForecast: Eingang, Auslöser" ObjectSize="1 Bit" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
						</ComObjectTable>
						<ComObjectRefs>
							<!-- Refresh PV Forecast Data -->
							<ComObjectRef Id="%AID%_O-%TT%00001_R-%TT%0000101" RefId="%AID%_O-%TT%00001" Name="RefreshData" Priority="Low" ObjectSize="1 Bit" DatapointType="DPST-1-17" />
						</ComObjectRefs>
					</Static>
				</ApplicationProgram>
			</ApplicationPrograms>
		</Manufacturer>
	</ManufacturerData>
</KNX>
